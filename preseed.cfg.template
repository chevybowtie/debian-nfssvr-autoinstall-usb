# Debian Preseed for unattended NFS + DHCP server install (hd-media method)
# This is a template file; variables are substituted from .env before USB creation

# Locale / keyboard
d-i debian-installer/locale string ${LOCALE}
d-i console-setup/ask_detect boolean false
d-i console-setup/layoutcode string ${KEYBOARD}
d-i keyboard-configuration/xkb-keymap select ${KEYBOARD}

# Networking: DHCP during install, because the installer needs the internet to
# fetch packages. post-install.sh then switches the server to its fixed address
# (${STATIC_IP}) for its real job as a DHCP/NFS server on a direct cable.
d-i netcfg/choose_interface select auto
d-i netcfg/link_wait_timeout string 30
d-i netcfg/dhcp_timeout string 60
# netcfg/hostname forces the name even if the DHCP server offers one
d-i netcfg/get_hostname string ${TARGET_HOSTNAME}
d-i netcfg/hostname string ${TARGET_HOSTNAME}
d-i netcfg/get_domain string ${DOMAIN}

# Mirror
d-i mirror/country string ${MIRROR_COUNTRY}
d-i mirror/http/hostname string ${MIRROR_HOST}
d-i mirror/http/directory string ${MIRROR_PATH}
d-i mirror/http/proxy string

# Account setup
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string ${USER_FULLNAME}
d-i passwd/username string ${TARGET_USERNAME}
d-i passwd/user-password-crypted password ${USER_PASSWORD_HASH}
d-i user-setup/allow-password-weak boolean true
d-i user-setup/allow-password-empty boolean false
d-i user-setup/encrypt-home boolean false
# d-i has no question for SSH keys; post-install.sh installs the key for this user

# Clock and timezone
d-i clock-setup/utc boolean true
d-i time/zone string ${TIMEZONE}
d-i clock-setup/ntp boolean true

# Partitioning
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
# partman-auto/disk and grub-installer/bootdev are set by select-disk.sh (partman/early_command)
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-auto-lvm/guided_size string max
d-i partman-auto/purge_lvm_from_device boolean true
d-i partman-auto/confirm boolean true
d-i partman/confirm_write_new_label boolean true
d-i partman/initialize_disk_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman/filter_mounted boolean true

# Package selection
tasksel tasksel/first multiselect standard
d-i pkgsel/include string openssh-server nfs-kernel-server isc-dhcp-server
d-i pkgsel/upgrade select none

# Boot loader
d-i grub-installer/with_other_os boolean true

# Stash post-install.sh in the installer's /tmp while the stick is known to be mounted
d-i preseed/early_command string \
  cp /hd-media/post-install.sh /tmp/post-install.sh

# Pick the target disk (never the installer USB) and wipe stale signatures on it.
# partman/early_command runs just before the partitioner; disks may not be
# visible yet when preseed/early_command runs.
d-i partman/early_command string \
  sh /hd-media/select-disk.sh "${TARGET_DISK}"

# Power off instead of rebooting: the stick is still plugged in and its menu
# auto-selects the installer, so a reboot would start (and wipe) the install again.
# Remove the stick, then power the server on.
d-i debian-installer/exit/poweroff boolean true
d-i finish-install/reboot_in_progress note

# Late command: run the post-install setup script inside the new system.
# in-target runs in a chroot of /target, where the installer's /hd-media does not
# exist, so copy the script in first. early_command stashed a copy in /tmp while
# the USB was known to be mounted; fall back to /hd-media if that is missing.
# The script's failure is returned so the installer reports it instead of hiding it.
d-i preseed/late_command string \
  src=/tmp/post-install.sh; [ -f "$src" ] || src=/hd-media/post-install.sh; \
  cp "$src" /target/root/post-install.sh && \
  in-target env TARGET_USERNAME="${TARGET_USERNAME}" SSH_KEY="${SSH_KEY_CONTENT}" \
    NFS_EXPORT="${NFS_EXPORT}" NFS_SUBNET="${NFS_SUBNET}" \
    STATIC_IP="${STATIC_IP}" NETMASK="${NETMASK}" SERVER_GATEWAY="${SERVER_GATEWAY}" \
    NAMESERVERS="${NAMESERVERS}" DHCP_SEND_GATEWAY="${DHCP_SEND_GATEWAY}" \
    DHCP_SEND_DNS="${DHCP_SEND_DNS}" DHCP_RANGE_START="${DHCP_RANGE_START}" \
    DHCP_RANGE_END="${DHCP_RANGE_END}" bash /root/post-install.sh; \
  rc=$?; rm -f /target/root/post-install.sh; exit $rc
