# Configuration for automated Debian NFS/DHCP server USB creator
# Copy to .env and customize before running the script

# Debian netinst ISO. Leave unset to auto-detect the current release
# (old point releases disappear from the mirror, so pinning can break).
# ISO_FILE="debian-13.7.0-amd64-netinst.iso"

# Debian release (bookworm, trixie, etc.)
DEBIAN_RELEASE="trixie"

# hd-media kernel/initrd base URL
HDMEDIA_BASE="https://deb.debian.org/debian/dists/${DEBIAN_RELEASE}/main/installer-amd64/current/images/hd-media"

# USB settings
# Normally pass --usb-device /dev/sdX on the command line, or leave this unset
# and the script will ask you to insert the stick and detect it.
# USB_DEVICE="/dev/sdX"
MOUNT_USB="/mnt/usb"

# Disk to install onto (on the target machine). Leave unset to use the first
# non-USB disk; set it explicitly, e.g. /dev/sda or /dev/disk/by-id/..., if
# the machine has several disks.
# TARGET_DISK="/dev/sda"

# Network settings
STATIC_IP="192.168.99.1"
NETMASK="255.255.255.0"
GATEWAY="192.168.99.254"
NAMESERVERS="8.8.8.8 1.1.1.1"
# Not named HOSTNAME: bash sets that to the machine running this script
TARGET_HOSTNAME="nfssvr"
DOMAIN="local"

# NFS settings
NFS_EXPORT="/srv/nfs"
NFS_SUBNET="192.168.99.0/24"

# DHCP settings
DHCP_RANGE_START="192.168.99.10"
DHCP_RANGE_END="192.168.99.20"

# System settings
TIMEZONE="America/Chicago"
LOCALE="en_US.UTF-8"
KEYBOARD="us"
MIRROR_COUNTRY="US"
MIRROR_HOST="deb.debian.org"
MIRROR_PATH="/debian"

# User settings
TARGET_USERNAME="backupadmin"
USER_FULLNAME="Backup Admin"
# SSH public key file path (optional; auto-detected from current user if not set)
# SSH_KEY_FILE="/path/to/ssh/key.pub"
# User password hash. Generate it with (prompts for the password, so it stays
# out of your shell history):
#   openssl passwd -6
# Keep the value in SINGLE quotes: the hash contains '$' characters.
USER_PASSWORD_HASH='<paste hash from: openssl passwd -6>'

# Script behavior
# true = always ask to insert the stick and detect it (default only when no USB_DEVICE)
# PROMPT_DEVICE=true
GRUB_VERBOSE=false

# Download retry attempts
MAX_RETRIES=3

# Checksum/signature verification is mandatory for downloads. Set to true only
# if you accept continuing when SHA256SUMS or its GPG signature can't be checked.
# ALLOW_UNVERIFIED=false

# hd-media kernel/initrd must match the ISO's kernel. If Debian ships a newer
# installer than the ISO, pin HDMEDIA_BASE to a matching build or set this to
# true to continue anyway (the install will likely fail to find modules).
# ALLOW_KERNEL_MISMATCH=false
